# Workspace-level Git Ignore

# Next.js Web App ignores
/web/node_modules/
/web/.next/
/web/out/
/web/build/
/web/*.tsbuildinfo
/web/next-env.d.ts
/web/.genkit/*
/web/.env*

# Flutter App ignores
/app/build/
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/.pub-cache/
/app/android/app/debug/
/app/android/app/profile/
/app/android/app/release/
/app/ios/Flutter/ephemeral/
/app/ios/Flutter/Generated.xcconfig
/app/ios/Flutter/flutter_export_environment.sh

# Root level ignores
node_modules/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log
firestore-debug.log
pglite-debug.log
*.apk